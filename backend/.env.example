# Application Configuration
APP_NAME="Weather Forecast Agent API"
APP_ENV="development"
APP_VERSION="0.1.0"
DEBUG=true

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Logging Configuration
LOG_LEVEL="INFO"

# Weather API Configuration (Google Maps / Weather API)
GOOGLE_WEATHER_API_KEY=""
WEATHER_API_TIMEOUT=10.0

# Database Configuration
DATABASE_URL="sqlite:///./weatheragent.db"

# Weather Statistics Configuration
MIN_STATISTICS_COVERAGE=70.0

# Groq LLM Configuration
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
LLM_TIMEOUT_SECONDS=15.0
LLM_TEMPERATURE=0.2

# Future Integration Placeholders (Do not set in this branch)
# OPENAI_API_KEY=""


